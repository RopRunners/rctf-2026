<section class="card narrow">
  <h1>Создай аккаунт мечтателя</h1>
  <% if @error %><p class="error"><%= h @error %></p><% end %>
  <form action="/register" method="post" class="stack">
    <label>Логин <input name="username" autocomplete="off" required></label>
    <label>Пароль <input name="password" type="password" required></label>
    <button type="submit">Зарегистрироваться и получить <%= Xingyuan::STARTER_NAME %></button>
  </form>
  <p class="muted">Уже с нами? <a href="/login">Войти</a>.</p>
</section>
